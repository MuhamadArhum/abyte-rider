rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Riders Collection
    match /riders/{riderId} {
      allow read: if true;
      allow create, update: if isValidId(riderId);
      allow delete: if isValidId(riderId);

      // Sub-collection of GPS breadcrumb history logs
      match /gps_logs/{logId} {
        allow read: if true;
        allow create, update: if isValidId(riderId) && isValidId(logId);
        allow delete: if isValidId(riderId) && isValidId(logId);
      }
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow read: if true;
      allow create, update: if isValidId(alertId);
      allow delete: if isValidId(alertId);
    }
  }
}
